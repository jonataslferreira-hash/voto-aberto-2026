{
  "name": "voto-aberto-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "dev:pages": "vite",
    "build": "vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "test": "node --test tests/providers.test.mjs tests/static-contract.test.mjs tests/dashboard-data.test.mjs tests/http-cache.test.mjs tests/server.test.mjs",
    "verify:pages": "node --test tests/pages-build.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "data:refresh": "node scripts/refresh-results.mjs",
    "data:import2022": "node scripts/import-2022.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^7.1.11"
  }
}
